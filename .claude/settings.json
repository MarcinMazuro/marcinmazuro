{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run start)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform validate:*)",
      "Bash(gcloud run services describe:*)",
      "Bash(gcloud firestore indexes:*)",
      "Bash(curl -s:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(terraform destroy:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
